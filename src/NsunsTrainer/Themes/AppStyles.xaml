<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- All NSUNS Trainer visuals live here. Flat, warm black, one accent color. -->

    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <SolidColorBrush x:Key="BgBrush" Color="#141211" />
    <SolidColorBrush x:Key="StripBrush" Color="#2A1D17" />
    <SolidColorBrush x:Key="LineBrush" Color="#2B2724" />
    <SolidColorBrush x:Key="TextBrush" Color="#EDE8E0" />
    <SolidColorBrush x:Key="MutedBrush" Color="#8C857B" />
    <SolidColorBrush x:Key="AccentBrush" Color="#E4572E" />
    <SolidColorBrush x:Key="DotOnBrush" Color="#6FCF97" />

    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="RowTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="MutedText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="Margin" Value="0,18,0,8" />
    </Style>

    <Style x:Key="BigValue" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- A row: no card, only a thin line under it -->
    <Style x:Key="Row" TargetType="Border">
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="Padding" Value="0,12" />
    </Style>

    <!-- Small keyboard-key look for hotkeys -->
    <Style x:Key="KeyCap" TargetType="Border">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="#3A3430" />
        <Setter Property="Background" Value="#1C1917" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Left edge bar, lights up when a patch is on -->
    <Style x:Key="ActiveBar" TargetType="Border">
        <Setter Property="Width" Value="3" />
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- Warning strip -->
    <Style x:Key="Strip" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource StripBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="3,0,0,0" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
</ResourceDictionary>